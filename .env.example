# Copy to .env and fill in. Never commit .env.

# Public hostname the sync worker publishes catalogue snapshots to (ADR-0030,
# ADR-0034), no trailing slash. The client reads <this>/catalogue/meta.json first.
# Required: the build fails without it. It is a build-time setting, never hard-coded.
VITE_CATALOGUE_R2_BASE_URL=

# Upstash Redis REST API - the FALLBACK data source (ADR-0015), read when R2
# cannot serve the catalogue. Supabase is never called from the client, so no
# Supabase keys belong here. Required: the build fails without them.
# Dashboard -> Redis -> REST API -> Endpoint (REST URL)
VITE_UPSTASH_REDIS_REST_URL=

# Dashboard -> Redis -> REST API -> Read Only Token
VITE_UPSTASH_REDIS_REST_READONLY_TOKEN=

# Optional: TV guide programme-title translation (Guide page "English" toggle).
# Endpoint must be LibreTranslate-compatible (POST { q, source, target, format }).
# Leave blank to fall back to the public MyMemory API, which is rate limited.
VITE_TRANSLATE_URL=
# Only needed if the endpoint requires an API key.
VITE_TRANSLATE_API_KEY=
